# digiRunner Gateway（設定方式見 docs/digirunner_setup.md）
# 不設定 DIGIRUNNER_BASE_URL 就直連 world-api（http://localhost:8000）；
# 要經過 digiRunner 時用 civsim govern --base-url http://localhost:31080，或打開下一行
# DIGIRUNNER_BASE_URL=http://localhost:31080
#
# digiRunner client 的帳密：照 docs/digirunner_setup.md 第 4 步的指令產生，指令會把真正的值加到 .env 的最後面。
# 這幾行刻意註解掉：.env 裡同一個名稱出現兩次時，程式和檢查腳本都只讀「第一個」，
# 如果這裡留著空白的 DIGIRUNNER_CLIENT_ID=，後面加上的真正值就讀不到。
# 政府 client，civsim govern 經過 digiRunner 時用來換 token
# DIGIRUNNER_CLIENT_ID=civsim-gov
# DIGIRUNNER_CLIENT_SECRET=
# 前端 client，只有檢查權限的腳本（deploy/digirunner/check_auth.ps1、check_auth.sh）用到
# DIGIRUNNER_FRONTEND_CLIENT_ID=civsim-frontend
# DIGIRUNNER_FRONTEND_CLIENT_SECRET=

# Modal 上自己架的模型（部署方式見 deploy/modal_llm.py）
LLM_PROVIDER=modal
LLM_BASE_URL=https://<modal deploy 印出的網址>/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=<modal secret 裡設的 VLLM_API_KEY>

LLM_TEMPERATURE=0
LLM_SEED=45

# 改用 GCP 的 Vertex AI（先執行 gcloud auth application-default login）：
# LLM_PROVIDER=vertex
# LLM_MODEL=gemini-3.6-flash
# GOOGLE_CLOUD_PROJECT=<GCP 專案 ID>
# GOOGLE_CLOUD_LOCATION=global
# 本機 Ollama：LLM_PROVIDER=ollama，LLM_MODEL=<ollama 的模型名稱>，LLM_BASE_URL 預設 http://localhost:11434/v1
