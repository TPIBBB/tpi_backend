# digiRunner Gateway
DIGIRUNNER_BASE_URL=http://localhost:18080
DIGIRUNNER_CLIENT_TOKEN=

# Modal 上自己架的模型（部署方式見 deploy/modal_llm.py；網址與金鑰跟部署的人拿）
LLM_PROVIDER=modal
LLM_BASE_URL=https://<modal deploy 印出的網址>/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=

LLM_TEMPERATURE=0
LLM_SEED=45

# 改用 Gemini：LLM_PROVIDER=gemini，LLM_MODEL=gemini-2.5-flash，LLM_API_KEY=<Gemini API key>，LLM_BASE_URL 留空
# 本機 Ollama：LLM_PROVIDER=ollama，LLM_MODEL=<ollama 的模型名稱>，LLM_BASE_URL 預設 http://localhost:11434/v1