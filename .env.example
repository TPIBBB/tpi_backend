# 複製成 .env 後填入
# PostgreSQL（使用 PostgresRecorder 時）
DATABASE_URL=postgresql://civsim:civsim@localhost:5432/civsim

# digiRunner Gateway（使用 HttpGateway 時，Agent 透過 Gateway 呼叫世界 API）
DIGIRUNNER_BASE_URL=http://localhost:18080
DIGIRUNNER_CLIENT_TOKEN=

# LLM（使用 LLMAgent 時；供應商尚未選定）
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# world-api 允許的前端來源（逗號分隔）
CIVSIM_CORS_ORIGINS=http://localhost:5173
